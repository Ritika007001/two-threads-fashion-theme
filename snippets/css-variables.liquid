{% doc %}
  Renders the theme's self-hosted font faces and the global CSS variables
  that come from theme settings: fonts, page layout, section spacing, the
  product image shape and one class per colour scheme.

  Fonts are served from the theme's assets folder (no external font services):
  Work Sans for body text and Playfair Display for headings, both variable
  fonts licensed under the SIL Open Font License 1.1 (see licenses/).

  Static design tokens that never change in the editor (the type scale, the
  spacing scale and motion timings) live in assets/critical.css.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% liquid
  assign section_spacing_mobile = settings.section_spacing | times: 0.66 | round
  assign default_scheme = settings.color_scheme
%}

{% style %}
  @font-face {
    font-family: 'Work Sans';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'work-sans-latin-ext-wght-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
  }

  @font-face {
    font-family: 'Work Sans';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'work-sans-latin-wght-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
  }

  @font-face {
    font-family: 'Work Sans';
    font-style: italic;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'work-sans-latin-ext-wght-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
  }

  @font-face {
    font-family: 'Work Sans';
    font-style: italic;
    font-weight: 100 900;
    font-display: swap;
    src: url('{{ 'work-sans-latin-wght-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
  }

  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'playfair-display-latin-ext-wght-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
  }

  @font-face {
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'playfair-display-latin-wght-normal.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
  }

  @font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'playfair-display-latin-ext-wght-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
  }

  @font-face {
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 400 900;
    font-display: swap;
    src: url('{{ 'playfair-display-latin-wght-italic.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
  }

  :root {
    --font-primary--family: 'Work Sans', Arial, Helvetica, sans-serif;
    --font-primary--style: normal;
    --font-primary--weight: 400;
    --font-heading--family: 'Playfair Display', Georgia, 'Times New Roman', serif;
    --font-heading--style: {{ settings.heading_style }};
    --font-heading--weight: {{ settings.heading_weight }};
    --font-size-base: {{ settings.base_font_size }}px;
    --heading-scale: {{ settings.heading_scale }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --section-spacing-desktop: {{ settings.section_spacing }}px;
    --section-spacing-mobile: {{ section_spacing_mobile }}px;
    --product-image-ratio: {{ settings.product_image_ratio }};
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* The default scheme, so anything outside <body> (dialog backdrops, the editor) has colours too */
    --color-background: {{ default_scheme.settings.background }};
    --color-foreground: {{ default_scheme.settings.text }};
    --color-surface: {{ default_scheme.settings.surface }};
    --color-border: {{ default_scheme.settings.border }};
    --color-accent: {{ default_scheme.settings.accent }};
  }

  {% for scheme in settings.color_schemes %}
    .color-{{ scheme.id }} {
      --color-background: {{ scheme.settings.background }};
      --color-foreground: {{ scheme.settings.text }};
      --color-surface: {{ scheme.settings.surface }};
      --color-border: {{ scheme.settings.border }};
      --color-accent: {{ scheme.settings.accent }};
    }
  {% endfor %}
{% endstyle %}
