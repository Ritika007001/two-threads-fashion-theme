{% doc %}
  Renders one row of the cart page: photo, name, options, price, quantity
  controls, remove link and line total.

  Quantity and remove work without JavaScript: the − and + buttons and the
  remove link are plain links to Shopify's cart change URL, and the number
  box is part of the cart form, sent with the Update cart button.

  @param {line_item} item - The cart line item
  @param {number} line - The item's position in the cart, starting at 1
  @param {string} [ratio] - Photo shape, for example '4 / 5'. Defaults to the product image shape in theme settings

  @example
  {% render 'cart-item', item: item, line: forloop.index %}
{% enddoc %}

{% liquid
  assign ratio = ratio | default: settings.product_image_ratio
  assign quantity_id = 'CartQuantity-' | append: line
  assign decrease_quantity = item.quantity | minus: 1
  assign increase_quantity = item.quantity | plus: 1
  assign item_title = item.product.title | default: item.title
%}

<li class="cart-item" style="--cart-ratio: {{ ratio }};">
  <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {% if item.image %}
      {{
        item.image
        | image_url: width: 400
        | image_tag: widths: '150, 250, 400', sizes: '(min-width: 750px) 140px, 100px', loading: 'lazy', class: 'cart-item__image'
      }}
    {% else %}
      {% render 'image-placeholder', ratio: ratio %}
    {% endif %}
  </a>

  <div class="cart-item__details">
    <h2 class="cart-item__title">
      <a href="{{ item.url }}">{{ item_title | escape }}</a>
    </h2>

    {% unless item.product.has_only_default_variant %}
      <ul class="cart-item__options" role="list">
        {% for option in item.options_with_values %}
          <li>{{ option.name | escape }}: {{ option.value | escape }}</li>
        {% endfor %}
      </ul>
    {% endunless %}

    {% if item.selling_plan_allocation %}
      <p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {% endif %}

    {% liquid
      assign visible_properties = 0
      for property in item.properties
        assign property_first_char = property.first | slice: 0
        if property.last != blank and property_first_char != '_'
          assign visible_properties = visible_properties | plus: 1
        endif
      endfor
    %}
    {% if visible_properties > 0 %}
      <ul class="cart-item__options" role="list">
        {% for property in item.properties %}
          {% assign property_first_char = property.first | slice: 0 %}
          {% if property.last != blank and property_first_char != '_' %}
            <li>{{ property.first | escape }}: {{ property.last | escape }}</li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}

    <p class="cart-item__unit-price">
      {% if item.original_price > item.final_price %}
        <span class="visually-hidden">{{ 'product.sale_price' | t }}</span>
        {{ item.final_price | money }}
        <span class="visually-hidden">{{ 'product.regular_price' | t }}</span>
        <s class="cart-item__compare">{{ item.original_price | money }}</s>
      {% else %}
        {{ item.final_price | money }}
      {% endif %}
    </p>

    {% if item.line_level_discount_allocations.size > 0 %}
      <ul class="cart-item__discounts" role="list">
        {% for allocation in item.line_level_discount_allocations %}
          <li class="cart-item__discount">
            {{ allocation.discount_application.title | escape }} (−{{ allocation.amount | money }})
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="cart-item__actions">
      <div class="cart-item__quantity">
        <label class="visually-hidden" for="{{ quantity_id }}">
          {{- 'cart.quantity_for' | t: title: item_title -}}
        </label>
        <a
          class="cart-item__step"
          href="{{ routes.cart_change_url }}?line={{ line }}&amp;quantity={{ decrease_quantity }}"
          rel="nofollow"
        >
          <span aria-hidden="true">−</span>
          <span class="visually-hidden">{{ 'cart.decrease' | t: title: item_title }}</span>
        </a>
        <input
          id="{{ quantity_id }}"
          class="cart-item__quantity-input"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          inputmode="numeric"
          data-cart-quantity
        >
        <a
          class="cart-item__step"
          href="{{ routes.cart_change_url }}?line={{ line }}&amp;quantity={{ increase_quantity }}"
          rel="nofollow"
        >
          <span aria-hidden="true">+</span>
          <span class="visually-hidden">{{ 'cart.increase' | t: title: item_title }}</span>
        </a>
      </div>

      <a class="cart-item__remove" href="{{ item.url_to_remove }}" rel="nofollow">
        {{ 'cart.remove' | t }}
        <span class="visually-hidden">{{ item_title | escape }}</span>
      </a>
    </div>
  </div>

  <div class="cart-item__total">
    <span class="visually-hidden">{{ 'cart.line_total' | t }}</span>
    {% if item.original_line_price > item.final_line_price %}
      <s class="cart-item__compare">{{ item.original_line_price | money }}</s>
    {% endif %}
    <span>{{ item.final_line_price | money }}</span>
  </div>
</li>

{% stylesheet %}
  .cart-item {
    display: grid;
    grid-template-columns: 8.75rem minmax(0, 1fr) auto;
    gap: 1.5rem;
    align-items: start;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cart-item__media {
    display: block;
    aspect-ratio: var(--cart-ratio);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .cart-item__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item__details {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .cart-item__title {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .cart-item__title a {
    color: inherit;
    text-decoration: none;
  }

  .cart-item__title a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cart-item__options {
    margin: 0;
    padding: 0;
    font-size: 0.9375rem;
    list-style: none;
    opacity: 0.85;
  }

  .cart-item__meta,
  .cart-item__unit-price {
    font-size: 0.9375rem;
  }

  .cart-item__compare {
    margin-inline-start: 0.375rem;
    opacity: 0.65;
  }

  .cart-item__discounts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-item__discount {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    font-size: 0.8125rem;
  }

  .cart-item__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.5rem;
  }

  .cart-item__quantity {
    display: inline-flex;
    align-items: stretch;
    min-height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
  }

  .cart-item__step {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    color: inherit;
    font-size: 1.25rem;
    text-decoration: none;
  }

  .cart-item__step:hover {
    background-color: var(--color-surface);
  }

  .cart-item__quantity-input {
    width: 3rem;
    border: 0;
    background: none;
    color: inherit;
    text-align: center;
    -moz-appearance: textfield;
  }

  .cart-item__quantity-input::-webkit-inner-spin-button,
  .cart-item__quantity-input::-webkit-outer-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .cart-item__remove {
    color: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cart-item__total {
    display: grid;
    justify-items: end;
    font-size: 1.0625rem;
    white-space: nowrap;
  }

  .cart-item__total .cart-item__compare {
    margin: 0;
    font-size: 0.875rem;
  }

  @media (max-width: 749px) {
    .cart-item {
      grid-template-columns: 6.25rem minmax(0, 1fr);
      gap: 1rem;
    }

    .cart-item__title {
      font-size: 1.0625rem;
    }

    .cart-item__total {
      grid-column: 2;
      justify-items: start;
      grid-row: 2;
      margin-top: -0.25rem;
    }
  }
{% endstylesheet %}
