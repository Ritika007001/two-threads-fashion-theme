{% doc %}
  Renders a product tile: image, title and price, linking to the product.
  Without a product, renders a placeholder tile so empty grids still show
  their layout.

  @param {product} [product] - The product to show. Leave out for a placeholder tile
  @param {string} [ratio] - Image shape, for example '4 / 5'. Defaults to the product image shape in theme settings
  @param {string} [heading_level] - Heading tag for the title. Defaults to 'h3'
  @param {string} [sample_title] - Without a product: a sample name, which turns the tile into a sample card
  @param {number} [sample_price] - Without a product: a sample price in the store's minor currency unit, for example 7900 for 79.00
  @param {string} [sample_image] - Without a product: file name of a built-in image in assets
  @param {string} [sample_alt] - Alt text for the built-in image
  @param {string} [sample_url] - Where a sample card links. Defaults to the all products collection

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, heading_level: 'h2' %}
  {% render 'product-card' %}
  {% render 'product-card', sample_title: 'Ribbed tank top', sample_price: 2900, sample_image: 'default-tops.jpg', sample_alt: 'White ribbed tank top' %}
{% enddoc %}

{% liquid
  assign ratio = ratio | default: settings.product_image_ratio
  assign heading_level = heading_level | default: 'h3'
  assign sample_url = sample_url | default: routes.all_products_collection_url
%}

<div class="product-card" style="--card-ratio: {{ ratio }};">
  {% if product != blank %}
    <a class="product-card__link" href="{{ product.url }}">
      <div class="product-card__media">
        {% if product.featured_media %}
          {{
            product.featured_media.preview_image
            | image_url: width: 1000
            | image_tag:
              widths: '300, 450, 600, 800, 1000',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw',
              loading: 'lazy',
              alt: product.featured_media.alt,
              class: 'product-card__image'
          }}
        {% else %}
          {% render 'image-placeholder', ratio: ratio %}
        {% endif %}

        {% unless product.available %}
          <span class="product-card__badge">{{ 'product.sold_out' | t }}</span>
        {% endunless %}
      </div>

      <{{ heading_level }} class="product-card__title">{{ product.title | escape }}</{{ heading_level }}>
    </a>

    <div class="product-card__price">
      {% if product.price_varies %}
        {% assign min_price = product.price_min | money %}
        {{ 'home.from_price' | t: price: min_price }}
      {% else %}
        {% render 'price', variant: product.selected_or_first_available_variant %}
      {% endif %}
    </div>
  {% elsif sample_title != blank %}
    {% # Sample card with a built-in image: same markup as a real product, so it looks identical. %}
    <a class="product-card__link" href="{{ sample_url }}">
      <div class="product-card__media">
        {% if sample_image != blank %}
          <img
            class="product-card__image"
            src="{{ sample_image | asset_img_url: '1000x' }}"
            srcset="
              {{ sample_image | asset_img_url: '450x' }} 450w,
              {{ sample_image | asset_img_url: '600x' }} 600w,
              {{ sample_image | asset_img_url: '800x' }} 800w,
              {{ sample_image | asset_img_url: '1000x' }} 1000w
            "
            sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw"
            width="800"
            height="1000"
            loading="lazy"
            alt="{{ sample_alt | escape }}"
          >
        {% else %}
          {% render 'image-placeholder', ratio: ratio, small: true %}
        {% endif %}
      </div>

      <{{ heading_level }} class="product-card__title">{{ sample_title | escape }}</{{ heading_level }}>
    </a>

    {% if sample_price != blank %}
      <div class="product-card__price">{{ sample_price | money }}</div>
    {% endif %}
  {% else %}
    <div class="product-card__media">
      {% render 'image-placeholder', ratio: ratio %}
    </div>
    <{{ heading_level }} class="product-card__title product-card__title--placeholder">
      {{- 'home.placeholder_product' | t -}}
    </{{ heading_level }}>
  {% endif %}
</div>

{% stylesheet %}
  .product-card {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .product-card__link {
    display: grid;
    gap: var(--space-3);
    color: inherit;
    text-decoration: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: var(--card-ratio, var(--product-image-ratio));
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: 0.25rem 0.625rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: var(--text-eyebrow);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-card__title {
    font-family: var(--font-primary--family);
    font-style: normal;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .product-card__link:hover .product-card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-card__title--placeholder {
    color: var(--color-text-subdued);
  }

  .product-card__price {
    font-size: var(--text-small);
    color: var(--color-text-subdued);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image {
      transition: none;
    }
  }
{% endstylesheet %}
