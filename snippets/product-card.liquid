{% doc %}
  Renders a product tile: image, title and price, linking to the product.
  Without a product, renders a placeholder tile so empty grids still show
  their layout.

  @param {product} [product] - The product to show. Leave out for a placeholder tile
  @param {string} [ratio] - Image shape, for example '4 / 5'. Defaults to '4 / 5'
  @param {string} [heading_level] - Heading tag for the title. Defaults to 'h3'

  @example
  {% render 'product-card', product: product %}
  {% render 'product-card', product: product, ratio: '1 / 1', heading_level: 'h2' %}
  {% render 'product-card' %}
{% enddoc %}

{% liquid
  assign ratio = ratio | default: '4 / 5'
  assign heading_level = heading_level | default: 'h3'
%}

<div class="product-card" style="--card-ratio: {{ ratio }};">
  {% if product != blank %}
    <a class="product-card__link" href="{{ product.url }}">
      <div class="product-card__media">
        {% if product.featured_media %}
          {{
            product.featured_media.preview_image
            | image_url: width: 1000
            | image_tag:
              widths: '300, 450, 600, 800, 1000',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 60vw',
              loading: 'lazy',
              alt: product.featured_media.alt,
              class: 'product-card__image'
          }}
        {% else %}
          {% render 'image-placeholder', ratio: ratio %}
        {% endif %}

        {% unless product.available %}
          <span class="product-card__badge">{{ 'product.sold_out' | t }}</span>
        {% endunless %}
      </div>

      <{{ heading_level }} class="product-card__title">{{ product.title | escape }}</{{ heading_level }}>
    </a>

    <div class="product-card__price">
      {% if product.price_varies %}
        {% assign min_price = product.price_min | money %}
        {{ 'home.from_price' | t: price: min_price }}
      {% else %}
        {% render 'price', variant: product.selected_or_first_available_variant %}
      {% endif %}
    </div>
  {% else %}
    <div class="product-card__media">
      {% render 'image-placeholder', ratio: ratio %}
    </div>
    <{{ heading_level }} class="product-card__title product-card__title--placeholder">
      {{- 'home.placeholder_product' | t -}}
    </{{ heading_level }}>
  {% endif %}
</div>

{% stylesheet %}
  .product-card {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .product-card__link {
    display: grid;
    gap: 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .product-card__media {
    position: relative;
    aspect-ratio: var(--card-ratio);
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card__link:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.625rem;
    background-color: var(--color-foreground);
    color: var(--color-background);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product-card__title {
    font-family: var(--font-primary--family);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .product-card__link:hover .product-card__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .product-card__title--placeholder {
    opacity: 0.6;
  }

  .product-card__price {
    font-size: 0.9375rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image {
      transition: none;
    }
  }
{% endstylesheet %}
