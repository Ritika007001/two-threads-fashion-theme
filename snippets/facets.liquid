{% doc %}
  Filter and sort controls for collection pages and search results.

  Renders one of two parts, so the section can place them in its layout:
  - 'toolbar': the form, the "Filter" button, the product count, the sort menu
    and the tags for active filters. Goes above the product grid.
  - 'panel': the filter groups. A column on desktop (sidebar layout) or a
    full-screen panel opened by the "Filter" button.

  Both parts must sit inside one element with the `facets-layout` class, and
  that element must be the <facets-layout> custom element for the optional
  auto-apply behaviour. Everything works without JavaScript: the form has an
  Apply button and reloads the page with the chosen filters.

  @param {string} part - 'toolbar' or 'panel'
  @param {object} results - The collection or search object, which holds filters and sort options
  @param {string} form_id - Unique id for the form, for example 'FacetsForm-' + section.id
  @param {string} action - The form's URL: the collection URL or the search URL
  @param {string} clear_url - URL that removes all filters
  @param {string} [terms] - Search terms, kept when filters change on the search page
  @param {string} [count_text] - Text such as "24 products", shown in the toolbar
  @param {boolean} [show_filters] - Show the filters
  @param {boolean} [show_sort] - Show the sort menu

  @example
  {% render 'facets', part: 'toolbar', results: collection, form_id: form_id, action: collection.url, clear_url: clear_url, show_filters: true, show_sort: true %}
  {% render 'facets', part: 'panel', results: collection, form_id: form_id, action: collection.url, clear_url: clear_url, show_filters: true %}
{% enddoc %}

{% liquid
  assign has_filters = false
  if show_filters and results.filters.size > 0
    assign has_filters = true
  endif

  assign sort_by = results.sort_by | default: results.default_sort_by
  assign toggle_id = form_id | append: '-toggle'

  assign active_count = 0
  for filter in results.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor
%}

{% if part == 'toolbar' %}
  <form id="{{ form_id }}" class="facets__form" action="{{ action }}" method="get" data-facets-form>
    {% if terms != blank %}
      <input type="hidden" name="q" value="{{ terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
    {% endif %}
  </form>

  <div class="facets__toolbar">
    {% if has_filters %}
      <input type="checkbox" id="{{ toggle_id }}" class="facets__toggle visually-hidden" data-facets-toggle>
      <label class="facets__open" for="{{ toggle_id }}">
        {{- 'facets.filter' | t -}}
        {%- if active_count > 0 %} ({{ active_count }}){% endif -%}
      </label>
    {% endif %}

    {% if count_text != blank %}
      <p class="facets__count" role="status">{{ count_text }}</p>
    {% endif %}

    {% if show_sort and results.sort_options.size > 0 %}
      <div class="facets__sort">
        <label class="facets__sort-label" for="{{ form_id }}-sort">{{ 'facets.sort_by' | t }}</label>
        <select
          id="{{ form_id }}-sort"
          class="facets__select"
          name="sort_by"
          form="{{ form_id }}"
          data-facets-auto
        >
          {% for option in results.sort_options %}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
              {%- if option.value == 'created-descending' -%}
                {{- 'facets.sort_newest' | t -}}
              {%- else -%}
                {{- option.name | escape -}}
              {%- endif -%}
            </option>
          {% endfor %}
        </select>
        <noscript>
          <button type="submit" form="{{ form_id }}" class="facets__sort-apply">{{ 'facets.apply' | t }}</button>
        </noscript>
      </div>
    {% elsif show_sort == false and sort_by != blank %}
      {% # Keep the current sort when filters change, even with the sort menu hidden. %}
      <input type="hidden" name="sort_by" value="{{ sort_by | escape }}" form="{{ form_id }}">
    {% endif %}
  </div>

  {% if has_filters and active_count > 0 %}
    <ul class="facets__active" role="list">
      {% for filter in results.filters %}
        {% if filter.type == 'price_range' %}
          {% if filter.min_value.value != nil or filter.max_value.value != nil %}
            {% capture price_label %}
              {%- if filter.min_value.value != nil -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}
              –
              {%- if filter.max_value.value != nil -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}
            {% endcapture %}
            <li>
              <a class="facets__chip" href="{{ filter.url_to_remove }}">
                {{ filter.label | escape }}: {{ price_label | strip }}
                <span aria-hidden="true">×</span>
                <span class="visually-hidden">{{ 'facets.remove_filter' | t }}</span>
              </a>
            </li>
          {% endif %}
        {% else %}
          {% for value in filter.active_values %}
            <li>
              <a class="facets__chip" href="{{ value.url_to_remove }}">
                {{ filter.label | escape }}: {{ value.label | escape }}
                <span aria-hidden="true">×</span>
                <span class="visually-hidden">{{ 'facets.remove_filter' | t }}</span>
              </a>
            </li>
          {% endfor %}
        {% endif %}
      {% endfor %}
      <li>
        <a class="facets__clear" href="{{ clear_url }}">{{ 'facets.clear_all' | t }}</a>
      </li>
    </ul>
  {% endif %}

{% elsif part == 'panel' and has_filters %}
  <div class="facets__panel" id="{{ form_id }}-panel">
    <div class="facets__panel-header">
      <h2 class="facets__panel-title">{{ 'facets.filter' | t }}</h2>
      <label class="facets__close" for="{{ toggle_id }}">
        {{- 'icon-close.svg' | inline_asset_content -}}
        <span class="visually-hidden">{{ 'facets.close' | t }}</span>
      </label>
    </div>

    {% for filter in results.filters %}
      {% liquid
        assign group_open = false
        if forloop.index <= 3
          assign group_open = true
        endif
        if filter.type == 'price_range'
          if filter.min_value.value != nil or filter.max_value.value != nil
            assign group_open = true
          endif
        elsif filter.active_values.size > 0
          assign group_open = true
        endif
      %}
      <details class="facets__group" {% if group_open %}open{% endif %}>
        <summary class="facets__group-title">
          {{ filter.label | escape }}
          {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif -%}
        </summary>

        {% if filter.type == 'price_range' %}
          {% liquid
            assign price_min = ''
            assign price_max = ''
            if filter.min_value.value != nil
              assign price_min = filter.min_value.value | divided_by: 100.0
            endif
            if filter.max_value.value != nil
              assign price_max = filter.max_value.value | divided_by: 100.0
            endif
            assign range_max = filter.range_max | divided_by: 100.0 | ceil
          %}
          <div class="facets__price">
            <div class="facets__price-field">
              <label for="{{ form_id }}-{{ filter.param_name | handle }}-min">{{ 'facets.price_from' | t }}</label>
              <div class="facets__price-input">
                <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                <input
                  id="{{ form_id }}-{{ filter.param_name | handle }}-min"
                  type="number"
                  name="{{ filter.min_value.param_name }}"
                  value="{{ price_min }}"
                  min="0"
                  max="{{ range_max }}"
                  step="0.01"
                  placeholder="0"
                  inputmode="decimal"
                  form="{{ form_id }}"
                  data-facets-auto
                >
              </div>
            </div>
            <div class="facets__price-field">
              <label for="{{ form_id }}-{{ filter.param_name | handle }}-max">{{ 'facets.price_to' | t }}</label>
              <div class="facets__price-input">
                <span aria-hidden="true">{{ cart.currency.symbol }}</span>
                <input
                  id="{{ form_id }}-{{ filter.param_name | handle }}-max"
                  type="number"
                  name="{{ filter.max_value.param_name }}"
                  value="{{ price_max }}"
                  min="0"
                  max="{{ range_max }}"
                  step="0.01"
                  placeholder="{{ range_max }}"
                  inputmode="decimal"
                  form="{{ form_id }}"
                  data-facets-auto
                >
              </div>
            </div>
          </div>
        {% else %}
          <ul class="facets__values" role="list">
            {% for value in filter.values %}
              {% liquid
                assign value_id = form_id | append: '-' | append: filter.param_name | append: '-' | append: forloop.index | handle
                assign value_disabled = false
                if value.count == 0 and value.active == false
                  assign value_disabled = true
                endif
              %}
              <li>
                <input
                  type="checkbox"
                  id="{{ value_id }}"
                  class="facets__checkbox"
                  name="{{ value.param_name }}"
                  value="{{ value.value | escape }}"
                  form="{{ form_id }}"
                  data-facets-auto
                  {% if value.active %}
                    checked
                  {% endif %}
                  {% if value_disabled %}
                    disabled
                  {% endif %}
                >
                <label class="facets__value{% if value_disabled %} facets__value--disabled{% endif %}" for="{{ value_id }}">
                  {{ value.label | escape }}
                  <span class="facets__value-count">({{ value.count }})</span>
                </label>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </details>
    {% endfor %}

    <div class="facets__panel-actions">
      <button type="submit" form="{{ form_id }}" class="button facets__apply">{{ 'facets.apply' | t }}</button>
      {% if active_count > 0 %}
        <a class="text-link" href="{{ clear_url }}">{{ 'facets.clear_all' | t }}</a>
      {% endif %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  /* Layout: results column, plus a filter column on desktop when the sidebar layout is used. */
  .facets-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
  }

  .facets-layout__main {
    min-width: 0;
  }

  /* Toolbar */
  .facets__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .facets__open {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .facets__toggle:focus-visible + .facets__open {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .facets__count {
    font-size: 0.9375rem;
  }

  .facets__sort {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-inline-start: auto;
  }

  .facets__sort-label {
    font-size: 0.875rem;
    white-space: nowrap;
  }

  .facets__select {
    min-height: 2.75rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .facets__sort-apply {
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-foreground);
    background: none;
    font: inherit;
    cursor: pointer;
  }

  /* Active filter tags */
  .facets__active {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin: -0.5rem 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .facets__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.25rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .facets__chip:hover {
    border-color: var(--color-foreground);
  }

  .facets__clear {
    color: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Filter panel: hidden until the Filter button is used (phones, and the drawer layout) */
  .facets__panel {
    display: none;
  }

  .facets-layout:has(.facets__toggle:checked) .facets__panel {
    position: fixed;
    inset: 0;
    z-index: 30;
    display: block;
    overflow-y: auto;
    padding: 1rem var(--page-margin) 2rem;
    background-color: var(--color-background);
  }

  html:has(.facets__toggle:checked) {
    overflow: hidden;
  }

  .facets__panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .facets__panel-title {
    font-size: 1.5rem;
  }

  .facets__close {
    --icon-stroke-width: 1.5;

    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    cursor: pointer;
  }

  .facets__close svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .facets__group {
    border-bottom: 1px solid var(--color-border);
  }

  .facets__group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
  }

  .facets__group-title::-webkit-details-marker {
    display: none;
  }

  .facets__group-title::after {
    content: '+';
    font-size: 1.25rem;
    line-height: 1;
  }

  .facets__group[open] > .facets__group-title::after {
    content: '−';
  }

  .facets__values {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0 0 1rem;
    list-style: none;
  }

  .facets__values li {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .facets__checkbox {
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    accent-color: var(--color-foreground);
  }

  .facets__value {
    flex: 1;
    padding: 0.25rem 0;
    cursor: pointer;
  }

  .facets__value-count {
    opacity: 0.7;
    font-size: 0.875rem;
  }

  .facets__value--disabled {
    opacity: 0.45;
    cursor: default;
  }

  .facets__price {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    padding-bottom: 1rem;
  }

  .facets__price-field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.8125rem;
  }

  .facets__price-input {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0.625rem;
    border: 1px solid var(--color-border);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
  }

  .facets__price-input input {
    width: 100%;
    min-width: 0;
    min-height: 2.5rem;
    border: 0;
    background: none;
    color: inherit;
  }

  .facets__panel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 1.5rem;
  }

  .facets__apply {
    flex: 1 0 auto;
  }

  /* With JavaScript, filters apply as soon as they change, so the Apply button is only needed in the open panel. */
  facets-layout.is-enhanced:not(:has(.facets__toggle:checked)) .facets__apply {
    display: none;
  }

  /* Desktop sidebar layout: filters always visible in a column. */
  @media (min-width: 990px) {
    .facets-layout--sidebar:has(.facets__panel) {
      grid-template-columns: 15rem minmax(0, 1fr);
    }

    .facets-layout--sidebar .facets__panel,
    .facets-layout--sidebar:has(.facets__toggle:checked) .facets__panel {
      position: sticky;
      top: 1.5rem;
      display: block;
      max-height: calc(100vh - 3rem);
      overflow-y: auto;
      padding: 0;
    }

    .facets-layout--sidebar .facets__open,
    .facets-layout--sidebar .facets__close {
      display: none;
    }

    html:has(.facets-layout--sidebar .facets__toggle:checked) {
      overflow: visible;
    }

    .facets-layout--sidebar .facets__panel-header {
      padding-top: 0.25rem;
    }

    .facets-layout--sidebar .facets__panel-title {
      font-size: 1.25rem;
    }
  }

  @media (max-width: 749px) {
    .facets__sort-label {
      display: none;
    }

    .facets__count {
      order: 3;
      flex-basis: 100%;
    }
  }
{% endstylesheet %}

{% javascript %}
  class FacetsLayout extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('[data-facets-form]');
      if (!this.form) return;

      this.classList.add('is-enhanced');

      // Leave out empty fields (such as an empty price box) so the page address stays clean.
      this.form.addEventListener('formdata', (event) => {
        for (const [name, value] of Array.from(event.formData.entries())) {
          if (value === '') event.formData.delete(name);
        }
      });

      this.addEventListener('change', (event) => {
        if (!event.target.matches('[data-facets-auto]')) return;

        // In the open filter panel, wait for the Apply button so shoppers can pick several filters.
        const panelOpen = Boolean(this.querySelector('[data-facets-toggle]:checked'));
        const isSort = event.target.name === 'sort_by';
        if (panelOpen && !isSort && !this.sidebarVisible()) return;

        this.form.requestSubmit();
      });
    }

    sidebarVisible() {
      return this.classList.contains('facets-layout--sidebar') && window.matchMedia('(min-width: 990px)').matches;
    }
  }

  if (!customElements.get('facets-layout')) customElements.define('facets-layout', FacetsLayout);
{% endjavascript %}
