{% doc %}
  Turns on the gentle fade-in of content as shoppers scroll, when the
  "Fade in content on scroll" theme setting is on.

  Rendered once in the layout's <head>. A tiny inline script marks the page
  as ready before anything is painted, so elements never flash and then hide.
  The script below then watches [data-reveal] elements and the children of
  [data-reveal-group] elements and shows them as they come into view.

  Nothing is hidden when the visitor prefers reduced motion, when JavaScript
  is off, or if the script fails to load within a few seconds.

  @example
  {% render 'scroll-reveal' %}
{% enddoc %}

{% if settings.enable_reveal %}
  <script>
    (function () {
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var root = document.documentElement;
      root.classList.add('reveal-enabled');
      setTimeout(function () {
        if (!window.themeRevealReady) root.classList.remove('reveal-enabled');
      }, 3000);
    })();
  </script>
{% endif %}

{% javascript %}
  (function () {
    const root = document.documentElement;
    if (!root.classList.contains('reveal-enabled')) return;
    window.themeRevealReady = true;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.1 }
    );

    function watch(scope) {
      scope.querySelectorAll('[data-reveal]').forEach((element) => {
        if (!element.classList.contains('is-visible')) observer.observe(element);
      });

      scope.querySelectorAll('[data-reveal-group]').forEach((group) => {
        Array.from(group.children).forEach((child, index) => {
          if (child.classList.contains('is-visible')) return;
          child.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 70}ms`);
          observer.observe(child);
        });
      });
    }

    watch(document);

    // The theme editor re-renders a section after each change, so watch the new content too.
    document.addEventListener('shopify:section:load', (event) => watch(event.target));
  })();
{% endjavascript %}
