<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Favicon, when one is chosen in theme settings %}
    {% render 'favicon' %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="color-{{ settings.color_scheme }}">
    <a class="skip-link" href="#MainContent">{{ 'header.skip_to_content' | t }}</a>

    <main id="MainContent" class="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
