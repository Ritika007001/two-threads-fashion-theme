{% comment %}
  "You may also like" row for the product and cart pages. Each block is one product
  tile: a product picked in the theme editor, or a sample name and price with
  a placeholder image until a product is picked.
{% endcomment %}

<div
  class="related-products full-width"
  style="
    --related-background: {{ section.settings.background_color }};
    --related-text-color: {{ section.settings.text_color }};
  "
>
  <div class="related-products__inner">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {% endif %}

    <ul class="card-grid" role="list" style="--columns: {{ section.blocks.size | at_least: 2 }};">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% if block.settings.product != blank %}
            {% render 'product-card', product: block.settings.product %}
          {% else %}
            <div class="product-card" style="--card-ratio: 4 / 5;">
              <div class="product-card__media">
                {% render 'image-placeholder', ratio: '4 / 5', small: true %}
              </div>
              <h3 class="product-card__title">{{ block.settings.name | escape }}</h3>
              <p class="product-card__price">{{ block.settings.price | escape }}</p>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .related-products {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: var(--related-background);
    color: var(--related-text-color);
  }

  .related-products__inner {
    grid-column: 2;
    padding-block: 4rem 5rem;
  }

  @media (max-width: 749px) {
    .related-products__inner {
      padding-block: 3rem 3.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "header",
      "content": "t:general.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FAFAF8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:labels.text_color",
      "default": "#2B2B2B"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:general.product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:general.product",
          "info": "t:info.sample_product"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.sample_name",
          "default": "Sample product"
        },
        {
          "type": "text",
          "id": "price",
          "label": "t:labels.sample_price",
          "default": "£49.00"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "presets": [
    {
      "name": "t:general.related_products"
    }
  ]
}
{% endschema %}
