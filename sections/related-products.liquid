{% comment %}
  "You may also like" row for the product and cart pages. Each block is one product
  tile: a product picked in the theme editor, or a sample name and price with
  a placeholder image until a product is picked.
{% endcomment %}

<div
  class="related-products section-band full-width {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="section-padding">
    {% render 'section-header', heading: section.settings.heading, eyebrow: section.settings.eyebrow %}

    <ul class="card-grid" role="list" style="--columns: {{ section.blocks.size | at_least: 2 }};" data-reveal-group>
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% if block.settings.product != blank %}
            {% render 'product-card', product: block.settings.product %}
          {% else %}
            <div class="product-card" style="--card-ratio: {{ settings.product_image_ratio }};">
              <div class="product-card__media">
                {% render 'image-placeholder', ratio: settings.product_image_ratio, small: true %}
              </div>
              <h3 class="product-card__title">{{ block.settings.name | escape }}</h3>
              <p class="product-card__price">{{ block.settings.price | escape }}</p>
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:general.related_products",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "You may also like"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:general.product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:general.product",
          "info": "t:info.sample_product"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:labels.sample_name",
          "default": "Sample product"
        },
        {
          "type": "text",
          "id": "price",
          "label": "t:labels.sample_price",
          "default": "€49.00"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "presets": [
    {
      "name": "t:general.related_products"
    }
  ]
}
{% endschema %}
