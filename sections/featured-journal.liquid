{% comment %}
  "From the journal": the latest posts from one blog. Without a chosen blog,
  uses the store's default "news" blog. Shows placeholder cards when there
  are no posts yet.
{% endcomment %}

{% liquid
  assign journal = section.settings.blog
  if journal == blank
    assign journal = blogs.news
  endif
  assign post_limit = section.settings.post_count
%}

<div class="featured-journal home-section">
  <div class="section-header">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    {% if journal.articles_count > 0 %}
      <a class="text-link" href="{{ journal.url }}">{{ 'home.view_journal' | t }}</a>
    {% endif %}
  </div>

  <ul class="card-grid" role="list" style="--columns: {{ section.settings.columns }};">
    {% for article in journal.articles limit: post_limit %}
      <li>
        {% render 'article-card',
          article: article,
          blog_url: journal.url,
          show_date: section.settings.show_date,
          show_tags: section.settings.show_tags,
          show_excerpt: section.settings.show_excerpt
        %}
      </li>
    {% else %}
      {% for i in (1..post_limit) %}
        <li>
          {% render 'article-card',
            show_date: section.settings.show_date,
            show_tags: section.settings.show_tags,
            show_excerpt: section.settings.show_excerpt
          %}
        </li>
      {% endfor %}
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "t:general.featured_journal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From the journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:general.blog",
      "info": "t:info.featured_journal"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "t:labels.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_journal"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
