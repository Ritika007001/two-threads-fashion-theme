{% comment %}
  "From the journal": the latest posts from one blog. Without a chosen blog,
  uses the store's default "news" blog. Until there are posts, three sample
  stories with built-in images (shipped in assets) show, so the section
  looks complete after installing. Real posts always take their place.
{% endcomment %}

{% liquid
  assign journal = section.settings.blog
  if journal == blank
    assign journal = blogs.news
  endif
  assign post_limit = section.settings.post_count

  assign link_label = 'home.view_journal' | t
  assign link_url = blank
  if journal.articles_count > 0
    assign link_url = journal.url
  endif
%}

<div
  class="featured-journal section-band full-width {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="section-padding">
    {% render 'section-header',
      heading: section.settings.heading,
      eyebrow: section.settings.eyebrow,
      link_label: link_label,
      link_url: link_url
    %}

    <ul class="card-grid" role="list" style="--columns: {{ section.settings.columns }};" data-reveal-group>
      {% for article in journal.articles limit: post_limit %}
        <li>
          {% render 'article-card',
            article: article,
            blog_url: journal.url,
            show_date: section.settings.show_date,
            show_tags: section.settings.show_tags,
            show_excerpt: section.settings.show_excerpt
          %}
        </li>
      {% else %}
        {% for i in (1..post_limit) %}
          {% liquid
            assign sample_image = ''
            assign sample_alt = ''
            assign sample_title = ''
            assign sample_intro = ''
            case forloop.index
              when 1
                assign sample_image = 'default-journal-capsule.jpg'
                assign sample_alt = 'home.default_images.journal_capsule' | t
                assign sample_title = 'home.default_journal.capsule_title' | t
                assign sample_intro = 'home.default_journal.capsule_intro' | t
              when 2
                assign sample_image = 'default-journal-knitwear-care.jpg'
                assign sample_alt = 'home.default_images.journal_knitwear_care' | t
                assign sample_title = 'home.default_journal.knitwear_care_title' | t
                assign sample_intro = 'home.default_journal.knitwear_care_intro' | t
              when 3
                assign sample_image = 'default-journal-fabrics.jpg'
                assign sample_alt = 'home.default_images.journal_fabrics' | t
                assign sample_title = 'home.default_journal.fabrics_title' | t
                assign sample_intro = 'home.default_journal.fabrics_intro' | t
            endcase
          %}
          <li>
            {% render 'article-card',
              show_date: section.settings.show_date,
              show_tags: section.settings.show_tags,
              show_excerpt: section.settings.show_excerpt,
              placeholder_image: sample_image,
              placeholder_alt: sample_alt,
              placeholder_title: sample_title,
              placeholder_excerpt: sample_intro
            %}
          </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:general.featured_journal",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "From the journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:general.blog",
      "info": "t:info.featured_journal"
    },
    {
      "type": "range",
      "id": "post_count",
      "label": "t:labels.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:labels.show_excerpt",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_journal"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
