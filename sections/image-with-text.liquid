{% comment %}
  "Our story": an image beside an eyebrow, a heading, a paragraph and a
  link. Until the merchant chooses an image, a built-in photo of hands
  folding linen (shipped in assets) shows, so the section looks complete
  after installing.
{% endcomment %}

<div
  class="image-with-text section-band full-width {{ section.settings.image_position }} {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="image-with-text__inner section-padding">
    <div class="image-with-text__media" data-reveal>
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'image-with-text__image'
        }}
      {% else %}
        {% # Built-in image, replaced as soon as the merchant picks one above. %}
        <img
          class="image-with-text__image"
          src="{{ 'default-our-story.jpg' | asset_img_url: '900x' }}"
          srcset="
            {{ 'default-our-story.jpg' | asset_img_url: '450x' }} 450w,
            {{ 'default-our-story.jpg' | asset_img_url: '600x' }} 600w,
            {{ 'default-our-story.jpg' | asset_img_url: '900x' }} 900w
          "
          sizes="(min-width: 750px) 50vw, 100vw"
          width="800"
          height="1000"
          loading="lazy"
          alt="{{ 'home.default_images.our_story' | t }}"
        >
      {% endif %}
    </div>

    <div class="image-with-text__content" data-reveal>
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="image-with-text__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
  }

  .image-with-text--image-right .image-with-text__media {
    order: 1;
  }

  .image-with-text__media {
    aspect-ratio: 4 / 5;
    max-height: 44rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
  }

  .image-with-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 32rem;
  }

  .image-with-text__content .eyebrow + .section-heading {
    margin-top: calc(var(--space-2) * -1);
  }

  .image-with-text__text {
    line-height: 1.7;
  }

  .image-with-text__text > * + * {
    margin-top: var(--space-4);
  }

  @media (max-width: 749px) {
    .image-with-text__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .image-with-text--image-right .image-with-text__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_portrait"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "image-with-text--image-left", "label": "t:options.position.left" },
        { "value": "image-with-text--image-right", "label": "t:options.position.right" }
      ],
      "default": "image-with-text--image-left"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made slowly, worn often"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Tell shoppers who you are and what you care about: where your pieces are made, the fabrics you choose and why. A few honest sentences go a long way.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
