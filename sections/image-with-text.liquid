{% comment %}
  "Our story": an image beside a heading, a paragraph and a link. Shows a
  placeholder box until an image is chosen.
{% endcomment %}

<div class="image-with-text full-width {{ section.settings.image_position }} {{ section.settings.background }}">
  <div class="image-with-text__inner home-section">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'image-with-text__image'
        }}
      {% else %}
        {% render 'image-placeholder', ratio: '4 / 5' %}
      {% endif %}
    </div>

    <div class="image-with-text__content">
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="image-with-text__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.link_label != blank and section.settings.link != blank %}
        <a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text {
    display: grid;
    grid-template-columns: var(--content-grid);
  }

  .image-with-text--panel {
    background-color: var(--color-panel);
  }

  .image-with-text__inner {
    grid-column: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
  }

  .image-with-text--image-right .image-with-text__media {
    order: 1;
  }

  .image-with-text__media {
    aspect-ratio: 4 / 5;
    max-height: 44rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
  }

  .image-with-text__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__content {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 32rem;
  }

  .image-with-text__text {
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .image-with-text__text > * + * {
    margin-top: 1rem;
  }

  @media (max-width: 749px) {
    .image-with-text__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
    }

    .image-with-text--image-right .image-with-text__media {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.image_with_text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_portrait"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:labels.image_position",
      "options": [
        { "value": "image-with-text--image-left", "label": "t:options.position.left" },
        { "value": "image-with-text--image-right", "label": "t:options.position.right" }
      ],
      "default": "image-with-text--image-left"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "image-with-text--page", "label": "t:options.background.page" },
        { "value": "image-with-text--panel", "label": "t:options.background.panel" }
      ],
      "default": "image-with-text--page"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Made slowly, worn often"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>Tell shoppers who you are and what you care about: where your pieces are made, the fabrics you choose and why. A few honest sentences go a long way.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.image_with_text"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
