{% comment %}
  All-collections page: a heading and a grid of collection tiles, in
  Shopify's default (alphabetical) order.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/list-collections
{% endcomment %}

<div class="collections-page">
  <h1 class="collections-page__title">
    {%- if section.settings.heading != blank -%}
      {{- section.settings.heading | escape -}}
    {%- else -%}
      {{- 'collections.title' | t -}}
    {%- endif -%}
  </h1>

  {% paginate collections by 24 %}
    {% if collections.size > 0 %}
      <ul class="product-grid collections-page__grid" role="list" style="--columns: {{ section.settings.columns }};">
        {% for collection in collections %}
          <li>
            {% render 'collection-card',
              collection: collection,
              ratio: section.settings.image_ratio,
              show_description: section.settings.show_description,
              heading_level: 'h2'
            %}
          </li>
        {% endfor %}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {% else %}
      <div class="empty-state">
        <p class="empty-state__title">{{ 'collections.empty' | t }}</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'collection.browse_all' | t }}</a>
      </div>
    {% endif %}
  {% endpaginate %}
</div>

{% stylesheet %}
  .collections-page {
    padding-block: 2.5rem 1rem;
  }

  .collections-page__title {
    margin-bottom: 2rem;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.1;
  }

  @media (max-width: 749px) {
    .collections-page {
      padding-top: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop all collections"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "3 / 4", "label": "t:options.image_ratio.tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.show_collection_description",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
