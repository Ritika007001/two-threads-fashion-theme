{% comment %}
  Full-width banner for the top of the home page. The heading and button sit
  over the empty left side of the image on larger screens, and below the
  image on mobile so the clothing on the right is never cropped. Shows a
  plain placeholder box until an image is chosen.
{% endcomment %}

<div
  class="hero full-width"
  style="
    --hero-heading-color: {{ section.settings.heading_color }};
    --hero-button-color: {{ section.settings.button_color }};
  "
>
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image',
          alt: section.settings.image.alt
      }}
    {% else %}
      {% render 'image-placeholder', class: 'hero__placeholder' %}
    {% endif %}
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.button_label != blank %}
        {% if section.settings.button_link != blank %}
          <a class="button hero__button" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {% elsif request.design_mode %}
          <span class="button hero__button">{{ section.settings.button_label | escape }}</span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    background-color: var(--color-panel);
  }

  .hero__media {
    aspect-ratio: 1376 / 768;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* Light placeholder, so the heading over it stays easy to read until an image is chosen */
  .hero__placeholder {
    background-color: var(--color-panel);
    color: var(--color-border);
  }

  /* Sized in vw to follow the image: its empty area is the left third */
  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-inline-start: max(var(--page-margin), 5vw);
  }

  .hero__content {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    max-width: 28vw;
  }

  .hero__heading {
    color: var(--hero-heading-color);
    font-size: clamp(2.25rem, 4.5vw, 4.5rem);
    line-height: 1.05;
  }

  .hero__button {
    border-color: var(--hero-button-color);
    background-color: var(--hero-button-color);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
  }

  .hero__button:hover {
    border-color: color-mix(in srgb, var(--hero-button-color) 85%, #000);
    background-color: color-mix(in srgb, var(--hero-button-color) 85%, #000);
  }

  @media (max-width: 749px) {
    .hero__inner {
      position: static;
      padding-inline: var(--page-margin);
    }

    .hero__content {
      max-width: none;
      padding-block: 2rem 2.5rem;
      gap: 1.25rem;
    }

    .hero__heading {
      font-size: 2.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_banner"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "New arrivals"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:labels.heading_color",
      "default": "#2B2B2B"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "t:labels.button_color",
      "default": "#6F6C5D"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
