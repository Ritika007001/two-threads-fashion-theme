{% comment %}
  Full-width banner for the top of the home page. The eyebrow, heading and
  button sit over the empty left side of the image on larger screens, and
  below the image on mobile so the clothing on the right is never cropped.
  Shows a plain placeholder box until an image is chosen.

  Colours come from the colour scheme. The merchant picks whether the text
  over the image uses the scheme's text colour or its background colour,
  whichever reads best on their photo.
{% endcomment %}

<div class="hero full-width {{ section.settings.text_on_image }}">
  <div class="hero__media">
    {% if section.settings.image != blank %}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero__image',
          alt: section.settings.image.alt
      }}
    {% else %}
      {% render 'image-placeholder', class: 'hero__placeholder' %}
    {% endif %}
  </div>

  <div class="hero__inner">
    <div class="hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {% endif %}

      {% if section.settings.button_label != blank %}
        {% if section.settings.button_link != blank %}
          <a class="button hero__button" href="{{ section.settings.button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {% elsif request.design_mode %}
          <span class="button hero__button">{{ section.settings.button_label | escape }}</span>
        {% endif %}
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    background-color: var(--color-surface);
  }

  .hero__media {
    aspect-ratio: 1376 / 768;
  }

  .hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }

  /* Light placeholder, so the heading over it stays easy to read until an image is chosen */
  .hero__placeholder {
    background-color: var(--color-surface);
    color: var(--color-border);
  }

  /* Sized in vw to follow the image: its empty area is the left third */
  .hero__inner {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    padding-inline-start: max(var(--page-margin), 5vw);
  }

  .hero__content {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 28vw;
  }

  /* Text colour over the image, chosen in the editor */
  .hero--text-foreground .hero__content {
    color: var(--color-foreground);
  }

  .hero--text-background .hero__content {
    color: var(--color-background);
  }

  .hero__eyebrow {
    color: inherit;
  }

  .hero__heading {
    font-size: var(--text-display);
    line-height: var(--leading-tight);
  }

  .hero__button {
    margin-top: var(--space-2);
  }

  /* Inverted button when the text is the background colour */
  .hero--text-background .hero__button {
    border-color: var(--color-background);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .hero--text-background .hero__button:hover {
    border-color: color-mix(in srgb, var(--color-background) 85%, var(--color-foreground));
    background-color: color-mix(in srgb, var(--color-background) 85%, var(--color-foreground));
  }

  @media (max-width: 749px) {
    .hero__inner {
      position: static;
      padding-inline: var(--page-margin);
    }

    .hero__content {
      max-width: none;
      padding-block: var(--space-6) var(--space-7);
      gap: var(--space-4);
    }

    /* Below the image on phones, the text sits on the page colour, so it must use the text colour */
    .hero--text-background .hero__content {
      color: var(--color-foreground);
    }

    .hero--text-background .hero__button {
      border-color: var(--color-foreground);
      background-color: var(--color-foreground);
      color: var(--color-background);
    }

    .hero__heading {
      font-size: var(--text-h1);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image",
      "info": "t:info.image_banner"
    },
    {
      "type": "select",
      "id": "text_on_image",
      "label": "t:labels.text_on_image",
      "info": "t:info.text_on_image",
      "options": [
        { "value": "hero--text-foreground", "label": "t:options.text_on_image.foreground" },
        { "value": "hero--text-background", "label": "t:options.text_on_image.background" }
      ],
      "default": "hero--text-foreground"
    },
    {
      "type": "header",
      "content": "t:general.content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "New season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.link",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
