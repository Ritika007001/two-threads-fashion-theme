{% comment %}
  "Shop by category" tiles. Each block is one tile: a collection, with an
  optional image and name that replace the collection's own.
{% endcomment %}

<div
  class="collection-list full-width"
  style="
    --collection-list-background: {{ section.settings.background_color }};
    --collection-list-title-color: {{ section.settings.title_color }};
  "
>
  <div class="collection-list__inner">
    {% if section.settings.heading != blank %}
      <div class="section-header">
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      </div>
    {% endif %}

    <ul class="card-grid collection-list__grid" role="list" style="--columns: {{ section.settings.columns }};">
      {% for block in section.blocks %}
        <li class="collection-tile" {{ block.shopify_attributes }}>
          {% render 'collection-card',
            collection: block.settings.collection,
            image: block.settings.image,
            label: block.settings.label,
            ratio: section.settings.image_ratio
          %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .collection-list {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: var(--collection-list-background);
  }

  .collection-list__inner {
    grid-column: 2;
    padding-block: 5rem;
  }

  .collection-list .section-header {
    margin-bottom: 2.5rem;
  }

  .collection-list .collection-list__grid {
    gap: 3rem 2rem;
  }

  .collection-list .collection-tile__title {
    color: var(--collection-list-title-color);
  }

  /* Two columns on phones, instead of the swipeable row other card grids use */
  @media (max-width: 749px) {
    .collection-list__inner {
      padding-block: 3.5rem;
    }

    .collection-list .collection-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
      gap: 2rem 1rem;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "3 / 4", "label": "t:options.image_ratio.tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:labels.background",
      "default": "#FAFAF8"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "t:labels.category_name_color",
      "default": "#2B2B2B"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.display_name",
          "info": "t:info.display_name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.tile_image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "blocks": [
        { "type": "category", "settings": { "label": "New in" } },
        { "type": "category", "settings": { "label": "Dresses" } },
        { "type": "category", "settings": { "label": "Knitwear" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
