{% comment %}
  "Shop by category" tiles. Each block is one tile: a collection, with an
  optional image and name that replace the collection's own.

  Each tile can also name a built-in image (shipped in assets) so the theme
  looks complete straight after installing. It shows only when the merchant
  has not chosen an image and the collection has no image of its own.
{% endcomment %}

<div
  class="collection-list section-band full-width {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="section-padding">
    {% render 'section-header', heading: section.settings.heading, eyebrow: section.settings.eyebrow %}

    <ul class="card-grid collection-list__grid" role="list" style="--columns: {{ section.settings.columns }};" data-reveal-group>
      {% for block in section.blocks %}
        {% liquid
          assign default_alt = ''
          case block.settings.default_image
            when 'default-tops.jpg'
              assign default_alt = 'home.default_images.tops' | t
            when 'default-dresses.jpg'
              assign default_alt = 'home.default_images.dresses' | t
            when 'default-bottoms.jpg'
              assign default_alt = 'home.default_images.bottoms' | t
            when 'default-knitwear.jpg'
              assign default_alt = 'home.default_images.knitwear' | t
          endcase
        %}
        <li class="collection-tile" {{ block.shopify_attributes }}>
          {% render 'collection-card',
            collection: block.settings.collection,
            image: block.settings.image,
            label: block.settings.label,
            default_image: block.settings.default_image,
            default_alt: default_alt
          %}
        </li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .collection-list .collection-list__grid {
    gap: var(--space-7) var(--space-6);
  }

  /* Two columns on phones, instead of the swipeable row other card grids use */
  @media (max-width: 749px) {
    .collection-list .collection-list__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row;
      gap: var(--space-6) var(--space-4);
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection_list",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop by category"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:general.category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:general.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:labels.display_name",
          "info": "t:info.display_name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:info.tile_image"
        },
        {
          "type": "select",
          "id": "default_image",
          "label": "t:labels.default_image",
          "info": "t:info.default_image",
          "options": [
            { "value": "", "label": "t:options.default_image.none" },
            { "value": "default-tops.jpg", "label": "t:options.default_image.tops" },
            { "value": "default-dresses.jpg", "label": "t:options.default_image.dresses" },
            { "value": "default-bottoms.jpg", "label": "t:options.default_image.bottoms" },
            { "value": "default-knitwear.jpg", "label": "t:options.default_image.knitwear" }
          ],
          "default": ""
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.collection_list",
      "blocks": [
        { "type": "category", "settings": { "label": "Tops", "default_image": "default-tops.jpg" } },
        { "type": "category", "settings": { "label": "Knitwear", "default_image": "default-knitwear.jpg" } },
        { "type": "category", "settings": { "label": "Dresses", "default_image": "default-dresses.jpg" } },
        { "type": "category", "settings": { "label": "Bottoms", "default_image": "default-bottoms.jpg" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
