        },
        {
          "type": "text",
          "id": "label_1",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link_1",
          "label": "t:labels.link"
        },
        {
          "type": "header",
          "content": "t:labels.link_2"
        },
        {
          "type": "text",
          "id": "label_2",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link_2",
          "label": "t:labels.link"
        },
        {
          "type": "header",
          "content": "t:labels.link_3"
        },
        {
          "type": "text",
          "id": "label_3",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link_3",
          "label": "t:labels.link"
        },
        {
          "type": "header",
          "content": "t:labels.link_4"
        },
        {
          "type": "text",
          "id": "label_4",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link_4",
          "label": "t:labels.link"
        },
        {
          "type": "header",
          "content": "t:labels.link_5"
        },
        {
          "type": "text",
          "id": "label_5",
          "label": "t:labels.link_label"
        },
        {
          "type": "url",
          "id": "link_5",
          "label": "t:labels.link"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:general.newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Join our newsletter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:labels.text",
          "default": "<p>New arrivals, journal stories and early access to sales.</p>"
        },
        {
          "type": "paragraph",
          "content": "t:info.newsletter"
        }
      ]
    },
    {
      "type": "store_details",
      "name": "t:general.store_details",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Visit us"
        },
        {
          "type": "richtext",
          "id": "details",
          "label": "t:labels.store_details",
          "default": "<p>Add your store address, opening hours and contact email here.</p>"
        }
      ]
    },
    {
      "type": "social",
