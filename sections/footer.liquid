{% comment %}
  Store footer, shared across all pages through the footer section group.

  Content comes from blocks the merchant can add, remove and reorder:
  link columns, a newsletter sign up, store details and social links. The
  bottom row shows the copyright line, the language and country selectors
  (only once the store has more than one of either) and payment icons.
{% endcomment %}

<footer class="site-footer full-width">
  <div class="site-footer__inner">
    {% if section.blocks.size > 0 %}
      <div class="site-footer__blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'links' %}
              <div class="site-footer__block" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                <ul class="site-footer__links" role="list">
                  {% for i in (1..5) %}
                    {% liquid
                      assign label_key = 'label_' | append: i
                      assign link_key = 'link_' | append: i
                      assign label = block.settings[label_key]
                      assign link = block.settings[link_key]
                    %}
                    {% if label != blank %}
                      {% if link != blank %}
                        <li>
                          <a
                            href="{{ link }}"
                            {% if link == request.path %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- label | escape -}}
                          </a>
                        </li>
                      {% elsif request.design_mode %}
                        {% # In the theme editor, show links whose page doesn't exist yet. %}
                        <li><span class="site-footer__link--empty">{{ label | escape }}</span></li>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </ul>
              </div>

            {% when 'newsletter' %}
              <div class="site-footer__block site-footer__block--newsletter" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% if block.settings.text != blank %}
                  <div class="site-footer__text">{{ block.settings.text }}</div>
                {% endif %}

                {% assign form_id = 'FooterNewsletter-' | append: block.id %}
                {% form 'customer', id: form_id, class: 'site-footer__newsletter' %}
                  <input type="hidden" name="contact[tags]" value="newsletter">

                  {% if form.posted_successfully? %}
                    <p class="site-footer__form-message" role="status">{{ 'footer.newsletter_success' | t }}</p>
                  {% else %}
                    <div class="site-footer__field">
                      <label class="visually-hidden" for="{{ form_id }}-email">
                        {{- 'footer.newsletter_email' | t -}}
                      </label>
                      <input
                        id="{{ form_id }}-email"
                        type="email"
                        name="contact[email]"
                        autocomplete="email"
                        placeholder="{{ 'footer.newsletter_email' | t }}"
                        required
                        {% if form.errors %}
                          aria-invalid="true"
                          aria-describedby="{{ form_id }}-error"
                        {% endif %}
                      >
                      <button type="submit" class="button site-footer__button">
                        {{- 'footer.newsletter_subscribe' | t -}}
                      </button>
                    </div>

                    {% if form.errors %}
                      <div id="{{ form_id }}-error" class="site-footer__form-message" role="alert">
                        {{ form.errors | default_errors }}
                      </div>
                    {% endif %}
                  {% endif %}
                {% endform %}
              </div>

            {% when 'store_details' %}
              <div class="site-footer__block" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% if block.settings.details != blank %}
                  <div class="site-footer__text">{{ block.settings.details }}</div>
                {% endif %}
              </div>

            {% when 'social' %}
              <div class="site-footer__block" {{ block.shopify_attributes }}>
                {% if block.settings.heading != blank %}
                  <h2 class="site-footer__heading">{{ block.settings.heading | escape }}</h2>
                {% endif %}

                {% render 'social-links' %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endif %}

    <div class="site-footer__bottom">
      {% assign current_year = 'now' | date: '%Y' %}
      <p class="site-footer__copyright">
        {{ 'footer.copyright' | t: year: current_year, shop_name: shop.name }}
      </p>

      {% liquid
        assign show_language = false
        assign show_country = false
        if section.settings.show_language_selector and localization.available_languages.size > 1
          assign show_language = true
        endif
        if section.settings.show_country_selector and localization.available_countries.size > 1
          assign show_country = true
        endif
      %}

      {% if show_language or show_country %}
        {% form 'localization', id: 'FooterLocalization', class: 'localization' %}
          {% if show_language %}
            <div class="localization__field">
              <label class="visually-hidden" for="FooterLocalization-language">
                {{- 'footer.language_label' | t -}}
              </label>
              <select
                id="FooterLocalization-language"
                class="localization__select"
                name="locale_code"
                aria-label="{{ 'footer.language_label' | t }}"
                data-localization-auto
              >
                {% for language in localization.available_languages %}
                  <option
                    value="{{ language.iso_code }}"
                    lang="{{ language.iso_code }}"
                    {% if language.iso_code == localization.language.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{- language.endonym_name | capitalize -}}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          {% if show_country %}
            <div class="localization__field">
              <label class="visually-hidden" for="FooterLocalization-country">
                {{- 'footer.country_label' | t -}}
              </label>
              <select
                id="FooterLocalization-country"
                class="localization__select"
                name="country_code"
                aria-label="{{ 'footer.country_label' | t }}"
                data-localization-auto
              >
                {% for country in localization.available_countries %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == localization.country.iso_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }} ({{ country.currency.iso_code }}
                    {{ country.currency.symbol }})
                  </option>
                {% endfor %}
              </select>
            </div>
          {% endif %}

          {% # Shown only when JavaScript is off; with JavaScript the form submits on change. %}
          <button type="submit" class="button button--secondary localization__submit" data-localization-submit>
            {{- 'footer.update_localization' | t -}}
          </button>
        {% endform %}
      {% elsif request.design_mode %}
        {% if section.settings.show_language_selector or section.settings.show_country_selector %}
          {% # Editor-only note until the store has a second language or market. %}
          <p class="site-footer__localization-note">{{ 'footer.localization_editor_note' | t }}</p>
        {% endif %}
      {% endif %}

      {% if section.settings.show_payment_icons %}
        {% if shop.enabled_payment_types.size > 0 %}
          <ul class="site-footer__payment" role="list">
            <li class="visually-hidden">{{ 'footer.payment_methods' | t }}</li>
            {% for type in shop.enabled_payment_types %}
              <li>{{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}</li>
            {% endfor %}
          </ul>
        {% elsif request.design_mode %}
          {% # Placeholder shown only in the theme editor until payment methods are set up in Shopify. %}
          <div class="site-footer__payment site-footer__payment--placeholder">
            <span class="site-footer__payment-placeholder" aria-hidden="true"></span>
            <span class="site-footer__payment-placeholder" aria-hidden="true"></span>
            <span class="site-footer__payment-placeholder" aria-hidden="true"></span>
            <span class="site-footer__payment-placeholder" aria-hidden="true"></span>
            <span class="site-footer__payment-note">{{ 'footer.payment_placeholder' | t }}</span>
          </div>
        {% endif %}
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    display: grid;
    grid-template-columns: var(--content-grid);
    margin-top: var(--space-8);
    background-color: var(--color-background);
    color: var(--color-foreground);
    border-top: 1px solid var(--color-line);
  }

  .site-footer__inner {
    grid-column: 2;
    padding: var(--space-8) 0 var(--space-6);
  }

  .site-footer__blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-7) var(--space-6);
    padding-bottom: var(--space-7);
  }

  .site-footer__block--newsletter {
    grid-column: span 2;
  }

  /* Footer headings as small capitals, matching section eyebrows */
  .site-footer__heading {
    margin-bottom: var(--space-4);
    font-family: var(--font-primary--family);
    font-style: normal;
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-text-subdued);
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover,
  .site-footer a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__links {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__link--empty {
    opacity: 0.5;
  }

  .site-footer__text {
    line-height: 1.6;
  }

  .site-footer__text > * + * {
    margin-top: 0.75rem;
  }

  .site-footer__newsletter {
    margin-top: 1rem;
  }

  .site-footer__field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 28rem;
  }

  .site-footer__field input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .site-footer__button {
    min-height: 2.75rem;
    padding: 0 var(--space-5);
  }

  .site-footer__form-message {
    margin-top: 0.75rem;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
    font-size: var(--text-small);
    color: var(--color-text-subdued);
  }

  .localization {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .localization__select {
    min-height: 2.5rem;
    max-width: 16rem;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
  }

  .localization__submit {
    min-height: 2.5rem;
    padding: 0 var(--space-4);
  }

  .localization--auto .localization__submit {
    display: none;
  }

  .site-footer__localization-note {
    max-width: 22rem;
    opacity: 0.7;
  }

  .site-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__payment-icon {
    width: 2.375rem;
    height: 1.5rem;
  }

  .site-footer__payment--placeholder {
    justify-content: flex-end;
    max-width: 22rem;
    text-align: end;
  }

  .site-footer__payment-placeholder {
    width: 2.375rem;
    height: 1.5rem;
    border: 1px dashed var(--color-border);
    border-radius: 0.25rem;
  }

  .site-footer__payment-note {
    flex-basis: 100%;
    opacity: 0.7;
  }

  @media (max-width: 749px) {
    .site-footer__block--newsletter {
      grid-column: 1 / -1;
    }

    .site-footer__bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
    }
  }
{% endstylesheet %}

{% javascript %}
  // Submit the language / country form as soon as a choice changes, and hide
  // the Update button, which is only needed when JavaScript is off.
  document.querySelectorAll('.localization').forEach((form) => {
    form.classList.add('localization--auto');
    form.querySelectorAll('[data-localization-auto]').forEach((select) => {
      select.addEventListener('change', () => form.submit());
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "info": "t:info.payment_icons",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.language_and_country"
    },
    {
      "type": "paragraph",
      "content": "t:info.localization"
    },
    {
      "type": "checkbox",
      "id": "show_language_selector",
      "label": "t:labels.show_language_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:labels.show_country_selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "t:general.link_column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "Shop"
        },
