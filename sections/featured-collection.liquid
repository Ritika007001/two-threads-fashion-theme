{% comment %}
  Featured products: a grid of product cards from one collection. Until the
  merchant picks a collection, four sample cards with built-in images
  (shipped in assets) show, so the section looks complete after installing.
  Choosing a collection replaces them with real products; a chosen
  collection with no products shows placeholder cards.
{% endcomment %}

{% liquid
  assign featured = section.settings.collection
  assign product_limit = section.settings.products_to_show

  assign link_label = 'home.view_all' | t
  assign link_url = blank
  if section.settings.show_view_all
    if featured != blank and featured.products_count > 0
      assign link_url = featured.url
    elsif featured == blank and collections.all.products_count > 0
      assign link_url = routes.all_products_collection_url
    endif
  endif
%}

<div
  class="featured-collection section-band full-width {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="section-padding">
    {% render 'section-header',
      heading: section.settings.heading,
      eyebrow: section.settings.eyebrow,
      link_label: link_label,
      link_url: link_url
    %}

    <ul class="card-grid" role="list" style="--columns: {{ section.settings.columns }};" data-reveal-group>
      {% if featured == blank %}
        {% liquid
          assign sample_limit = product_limit | at_most: 4
          assign sample_images = 'default-sample-1.jpg,default-sample-2.jpg,default-sample-3.jpg,default-sample-4.jpg' | split: ','
          assign sample_prices = '2900,7900,18900,2500' | split: ','
        %}
        {% for i in (1..sample_limit) %}
          {% liquid
            assign sample_index = forloop.index0
            assign sample_image = sample_images[sample_index]
            assign sample_price = sample_prices[sample_index] | plus: 0
            case forloop.index
              when 1
                assign sample_title = 'home.sample_products.tank_top' | t
                assign sample_alt = 'home.default_images.sample_tank_top' | t
              when 2
                assign sample_title = 'home.sample_products.jeans' | t
                assign sample_alt = 'home.default_images.sample_jeans' | t
              when 3
                assign sample_title = 'home.sample_products.jacket' | t
                assign sample_alt = 'home.default_images.sample_jacket' | t
              when 4
                assign sample_title = 'home.sample_products.tee' | t
                assign sample_alt = 'home.default_images.sample_tee' | t
            endcase
          %}
          <li>
            {% render 'product-card',
              sample_title: sample_title,
              sample_price: sample_price,
              sample_image: sample_image,
              sample_alt: sample_alt
            %}
          </li>
        {% endfor %}
      {% else %}
        {% for product in featured.products limit: product_limit %}
          <li>{% render 'product-card', product: product %}</li>
        {% else %}
          {% for i in (1..product_limit) %}
            <li>{% render 'product-card' %}</li>
          {% endfor %}
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection",
      "info": "t:info.featured_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all",
      "default": true
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--page"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
