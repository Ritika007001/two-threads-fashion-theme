{% comment %}
  Featured products: a grid of product cards from one collection. Without a
  chosen collection, uses all products. Shows placeholder cards when there
  are no products yet.
{% endcomment %}

{% liquid
  assign featured = section.settings.collection
  if featured == blank
    assign featured = collections.all
  endif
  assign product_limit = section.settings.products_to_show
%}

<div class="featured-collection home-section">
  {% if section.settings.heading != blank or section.settings.show_view_all %}
    <div class="section-header">
      {% if section.settings.heading != blank %}
        <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.show_view_all and featured.products_count > 0 %}
        <a class="text-link" href="{{ featured.url }}">{{ 'home.view_all' | t }}</a>
      {% endif %}
    </div>
  {% endif %}

  <ul class="card-grid" role="list" style="--columns: {{ section.settings.columns }};">
    {% for product in featured.products limit: product_limit %}
      <li>{% render 'product-card', product: product, ratio: section.settings.image_ratio %}</li>
    {% else %}
      {% for i in (1..product_limit) %}
        <li>{% render 'product-card', ratio: section.settings.image_ratio %}</li>
      {% endfor %}
    {% endfor %}
  </ul>
</div>

{% schema %}
{
  "name": "t:general.featured_collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Featured pieces"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:general.collection",
      "info": "t:info.featured_collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:labels.image_ratio",
      "options": [
        { "value": "4 / 5", "label": "t:options.image_ratio.portrait" },
        { "value": "1 / 1", "label": "t:options.image_ratio.square" },
        { "value": "3 / 4", "label": "t:options.image_ratio.tall" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:labels.show_view_all",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
