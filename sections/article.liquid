{% comment %}
  Journal post page: tags, title, date, author and reading time, a "Copy
  link" button, the featured image, the post itself, previous/next links,
  more recent posts and, when turned on for the blog, comments.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

{% liquid
  assign word_count = article.content | strip_html | split: ' ' | size
  assign reading_minutes = word_count | divided_by: 200 | floor | at_least: 1
  assign previous_post = blog.previous_article
  assign next_post = blog.next_article
%}

<article class="journal-post">
  <header class="journal-post__header">
    {% if section.settings.show_tags and article.tags.size > 0 %}
      <ul class="journal-post__tags" role="list">
        {% for tag in article.tags %}
          <li>
            <a class="article-card__tag" href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag | escape }}</a>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <h1 class="journal-post__title">{{ article.title | escape }}</h1>

    <div class="journal-post__meta-row">
      <p class="journal-post__meta">
        {%- if section.settings.show_date -%}
          {{- article.published_at | time_tag: format: 'date' -}}
        {%- endif -%}
        {%- if section.settings.show_author and article.author != blank -%}
          {%- if section.settings.show_date %} · {% endif -%}
          {{- 'blog.by_author' | t: author: article.author -}}
        {%- endif -%}
        {%- if section.settings.show_reading_time -%}
          {%- if section.settings.show_date or section.settings.show_author %} · {% endif -%}
          {{- 'blog.reading_time' | t: minutes: reading_minutes -}}
        {%- endif -%}
      </p>

      {% if section.settings.show_copy_link %}
        <copy-link class="journal-post__copy" data-url="{{ request.origin }}{{ article.url }}">
          <button
            type="button"
            class="journal-post__copy-button"
            data-label-copied="{{ 'blog.link_copied' | t | escape }}"
            hidden
          >
            {{- 'blog.copy_link' | t -}}
          </button>
          <span class="visually-hidden" role="status" data-copy-status></span>
        </copy-link>
      {% endif %}
    </div>
  </header>

  {% if section.settings.show_image and article.image %}
    <div class="journal-post__image {{ section.settings.image_width }}">
      {{
        article.image
        | image_url: width: 2400
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '(min-width: 1200px) 1100px, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: article.image.alt,
          class: 'journal-post__img'
      }}
    </div>
  {% endif %}

  <div class="journal-post__content rte">
    {{ article.content }}
  </div>

  {% if section.settings.show_prev_next %}
    {% if previous_post != blank or next_post != blank %}
      <nav class="journal-post__nav" aria-label="{{ 'blog.post_navigation' | t }}">
        {% if previous_post != blank %}
          {% liquid
            assign previous_url = previous_post.url | default: previous_post
            assign previous_title = previous_post.title
          %}
          <a class="journal-post__nav-link journal-post__nav-link--previous" href="{{ previous_url }}">
            <span class="journal-post__nav-label">← {{ 'blog.previous_post' | t }}</span>
            {% if previous_title != blank %}
              <span class="journal-post__nav-title">{{ previous_title | escape }}</span>
            {% endif %}
          </a>
        {% endif %}
        {% if next_post != blank %}
          {% liquid
            assign next_url = next_post.url | default: next_post
            assign next_title = next_post.title
          %}
          <a class="journal-post__nav-link journal-post__nav-link--next" href="{{ next_url }}">
            <span class="journal-post__nav-label">{{ 'blog.next_post' | t }} →</span>
            {% if next_title != blank %}
              <span class="journal-post__nav-title">{{ next_title | escape }}</span>
            {% endif %}
          </a>
        {% endif %}
      </nav>
    {% endif %}
  {% endif %}

  {% if blog.comments_enabled? %}
    <section class="journal-post__comments" id="comments" aria-labelledby="CommentsTitle">
      <h2 id="CommentsTitle" class="journal-post__section-title">
        {{ 'blog.comments_count' | t: count: article.comments_count }}
      </h2>

      {% if article.comments_count > 0 %}
        {% paginate article.comments by 10 %}
          <ol class="journal-post__comment-list" role="list">
            {% for comment in article.comments %}
              <li class="journal-post__comment">
                <p class="journal-post__comment-meta">
                  <strong>{{ comment.author | escape }}</strong>
                  · {{ comment.created_at | time_tag: format: 'date' }}
                </p>
                <div class="journal-post__comment-body">{{ comment.content }}</div>
              </li>
            {% endfor %}
          </ol>
          {% render 'pagination', paginate: paginate %}
        {% endpaginate %}
      {% else %}
        <p class="journal-post__no-comments">{{ 'blog.no_comments' | t }}</p>
      {% endif %}

      {% form 'new_comment', article, class: 'journal-post__comment-form' %}
        <h3 class="journal-post__form-title">{{ 'blog.comment_form_title' | t }}</h3>

        {% if form.posted_successfully? %}
          <p class="journal-post__form-message" role="status">
            {%- if blog.moderated? -%}
              {{- 'blog.comment_moderated' | t -}}
            {%- else -%}
              {{- 'blog.comment_posted' | t -}}
            {%- endif -%}
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="journal-post__form-message" role="alert">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div class="journal-post__fields">
          <div class="journal-post__field">
            <label for="CommentAuthor">{{ 'blog.comment_name' | t }}</label>
            <input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author | escape }}" autocomplete="name" required>
          </div>
          <div class="journal-post__field">
            <label for="CommentEmail">{{ 'blog.comment_email' | t }}</label>
            <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email | escape }}" autocomplete="email" required>
          </div>
          <div class="journal-post__field journal-post__field--full">
            <label for="CommentBody">{{ 'blog.comment_body' | t }}</label>
            <textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body | escape }}</textarea>
          </div>
        </div>

        {% if blog.moderated? %}
          <p class="journal-post__form-note">{{ 'blog.comment_moderation_note' | t }}</p>
        {% endif %}

        <button type="submit" class="button">{{ 'blog.comment_submit' | t }}</button>
      {% endform %}
    </section>
  {% endif %}
</article>

{% if section.settings.show_more %}
  {% liquid
    assign more_limit = section.settings.more_count
    assign more_fetch = more_limit | plus: 1
    assign more_shown = 0
  %}
  {% capture more_posts %}
    {%- for other in blog.articles limit: more_fetch -%}
      {%- if other.id != article.id and more_shown < more_limit -%}
        {%- assign more_shown = more_shown | plus: 1 -%}
        <li>
          {% render 'article-card',
            article: other,
            blog_url: blog.url,
            show_date: true,
            show_tags: true,
            show_reading_time: section.settings.show_reading_time
          %}
        </li>
      {%- endif -%}
    {%- endfor -%}
  {% endcapture %}

  {% if more_shown > 0 %}
    <section class="journal-more" aria-labelledby="MorePostsTitle">
      <div class="section-header">
        <h2 id="MorePostsTitle" class="section-heading">
          {%- if section.settings.more_heading != blank -%}
            {{- section.settings.more_heading | escape -}}
          {%- else -%}
            {{- 'blog.more_heading' | t -}}
          {%- endif -%}
        </h2>
        <a class="text-link" href="{{ blog.url }}">{{ 'blog.see_all' | t }}</a>
      </div>
      <ul class="card-grid" role="list" style="--columns: 3;">
        {{ more_posts }}
      </ul>
    </section>
  {% endif %}
{% endif %}

{% stylesheet %}
  .journal-post {
    --post-width: 44rem;

    padding-block: 2.5rem 1rem;
  }

  .journal-post__header,
  .journal-post__content,
  .journal-post__nav,
  .journal-post__comments {
    max-width: var(--post-width);
    margin-inline: auto;
  }

  .journal-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .journal-post__title {
    font-size: var(--text-h1);
    line-height: var(--leading-tight);
  }

  .journal-post__meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .journal-post__meta {
    font-size: 0.9375rem;
    opacity: 0.85;
  }

  .journal-post__copy {
    display: block;
  }

  .journal-post__copy-button {
    min-height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid var(--color-foreground);
    border-radius: 2rem;
    background: none;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .journal-post__copy-button:hover {
    background-color: var(--color-surface);
  }

  .journal-post__image {
    margin: 2rem auto 2.5rem;
    overflow: hidden;
  }

  .journal-post__image--contained {
    max-width: var(--post-width);
  }

  .journal-post__image--wide {
    max-width: 70rem;
  }

  .journal-post__img {
    width: 100%;
    height: auto;
    max-height: 80svh;
    object-fit: cover;
  }

  .journal-post__nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .journal-post__nav-link {
    display: grid;
    gap: 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .journal-post__nav-link--next {
    grid-column: 2;
    text-align: end;
  }

  .journal-post__nav-label {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .journal-post__nav-title {
    font-family: var(--font-heading--family);
    font-size: 1.125rem;
  }

  .journal-post__nav-link:hover .journal-post__nav-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .journal-post__comments {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .journal-post__section-title {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .journal-post__comment-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journal-post__comment {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .journal-post__comment-meta {
    margin-bottom: 0.5rem;
    font-size: 0.9375rem;
  }

  .journal-post__comment-body {
    line-height: 1.6;
  }

  .journal-post__no-comments {
    opacity: 0.85;
  }

  .journal-post__comment-form {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 2.5rem;
  }

  .journal-post__form-title {
    font-size: 1.25rem;
  }

  .journal-post__fields {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    width: 100%;
  }

  .journal-post__field--full {
    grid-column: 1 / -1;
  }

  .journal-post__field label {
    display: block;
    margin-bottom: 0.375rem;
    font-size: 0.875rem;
  }

  .journal-post__field input,
  .journal-post__field textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .journal-post__form-note {
    font-size: 0.875rem;
    opacity: 0.85;
  }

  .journal-more {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 749px) {
    .journal-post {
      padding-top: 1.5rem;
    }

    .journal-post__image--wide {
      margin-inline: calc(var(--page-margin) * -1);
    }

    .journal-post__nav,
    .journal-post__fields {
      grid-template-columns: minmax(0, 1fr);
    }

    .journal-post__nav-link--next {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% javascript %}
  class CopyLink extends HTMLElement {
    connectedCallback() {
      this.button = this.querySelector('button');
      this.status = this.querySelector('[data-copy-status]');
      if (!this.button) return;

      this.label = this.button.textContent;
      this.button.hidden = false;
      this.button.addEventListener('click', () => this.copy());
    }

    async copy() {
      const url = this.dataset.url || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        this.showCopied();
      } catch (error) {
        // Clipboard not available (for example, on an insecure page): let the reader copy it by hand.
        window.prompt('', url);
      }
    }

    showCopied() {
      const copiedLabel = this.button.dataset.labelCopied;
      this.button.textContent = copiedLabel;
      if (this.status) this.status.textContent = copiedLabel;
      clearTimeout(this.timer);
      this.timer = setTimeout(() => {
        this.button.textContent = this.label;
        if (this.status) this.status.textContent = '';
      }, 2000);
    }
  }

  if (!customElements.get('copy-link')) customElements.define('copy-link', CopyLink);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:labels.show_featured_image",
      "default": true
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "t:labels.image_width",
      "options": [
        { "value": "journal-post__image--wide", "label": "t:options.image_width.wide" },
        { "value": "journal-post__image--contained", "label": "t:options.image_width.contained" }
      ],
      "default": "journal-post__image--wide"
    },
    {
      "type": "header",
      "content": "t:labels.post_details"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:labels.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:labels.show_date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:labels.show_author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:labels.show_reading_time",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_copy_link",
      "label": "t:labels.show_copy_link",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.after_post"
    },
    {
      "type": "checkbox",
      "id": "show_prev_next",
      "label": "t:labels.show_prev_next",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_more",
      "label": "t:labels.show_more_posts",
      "default": true
    },
    {
      "type": "text",
      "id": "more_heading",
      "label": "t:labels.heading",
      "default": "More from the journal"
    },
    {
      "type": "range",
      "id": "more_count",
      "label": "t:labels.post_count",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "paragraph",
      "content": "t:info.comments"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
