{% comment %}
  Page reached from a "reset your password" email: the customer chooses a
  new password.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/customers-reset-password
{% endcomment %}

{% render 'account-styles' %}

<div class="account">
  <h1 class="account__title account__title--center">{{ 'customers.reset.title' | t }}</h1>
  {% if email != blank %}
    <p class="account__intro">{{ 'customers.reset.intro' | t: email: email }}</p>
  {% endif %}

  {% form 'reset_customer_password', id: 'CustomerReset', class: 'account__form account__form--narrow' %}
    {% if form.errors %}
      <div class="account__message" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}

    <div class="account__field">
      <label for="CustomerReset-password">{{ 'customers.reset.password' | t }}</label>
      <input
        id="CustomerReset-password"
        type="password"
        name="customer[password]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <div class="account__field">
      <label for="CustomerReset-password-confirm">{{ 'customers.reset.password_confirm' | t }}</label>
      <input
        id="CustomerReset-password-confirm"
        type="password"
        name="customer[password_confirmation]"
        autocomplete="new-password"
        required
        {% if form.errors contains 'password_confirmation' %}
          aria-invalid="true"
        {% endif %}
      >
    </div>

    <button type="submit" class="button">{{ 'customers.reset.submit' | t }}</button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.customer_reset",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
