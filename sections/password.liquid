{% comment %}
  "Store is locked" page, shown while the store is password protected (for
  example during the free trial): store name, a short message, an email
  sign up and a small password entry for the owner and invited guests.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% assign current_year = 'now' | date: '%Y' %}

<div class="password-page full-width {{ section.settings.background }}">
  <div class="password-page__inner">
    {% if section.settings.show_store_name %}
      <p class="password-page__store">{{ shop.name | escape }}</p>
    {% endif %}

    <h1 class="password-page__title">
      {%- if section.settings.heading != blank -%}
        {{- section.settings.heading | escape -}}
      {%- else -%}
        {{- 'password.title' | t -}}
      {%- endif -%}
    </h1>

    {% if shop.password_message != blank %}
      <p class="password-page__message">{{ shop.password_message | escape }}</p>
    {% endif %}

    {% if section.settings.show_signup %}
      <div class="password-page__signup">
        {% if section.settings.signup_heading != blank %}
          <h2 class="password-page__signup-title">{{ section.settings.signup_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.signup_text != blank %}
          <p class="password-page__signup-text">{{ section.settings.signup_text | escape }}</p>
        {% endif %}

        {% form 'customer', id: 'PasswordSignup', class: 'password-page__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {% if form.posted_successfully? %}
            <p class="password-page__notice" role="status">{{ 'password.signup_success' | t }}</p>
          {% else %}
            <div class="password-page__field">
              <label class="visually-hidden" for="PasswordSignupEmail">{{ 'footer.newsletter_email' | t }}</label>
              <input
                id="PasswordSignupEmail"
                type="email"
                name="contact[email]"
                autocomplete="email"
                placeholder="{{ 'footer.newsletter_email' | t }}"
                required
              >
              <button type="submit" class="button">{{ 'password.signup_button' | t }}</button>
            </div>
            {% if form.errors %}
              <div class="password-page__notice" role="alert">{{ form.errors | default_errors }}</div>
            {% endif %}
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    {% form 'storefront_password', class: 'password-page__entry-form' %}
      <details class="password-page__entry" {% if form.errors %}open{% endif %}>
        <summary class="password-page__entry-toggle">{{ 'password.entry_toggle' | t }}</summary>
        <div class="password-page__entry-body">
          {% if form.errors %}
            <div class="password-page__notice" role="alert">{{ form.errors | default_errors }}</div>
          {% endif %}
          <label class="password-page__entry-label" for="StorePassword">{{ 'password.password' | t }}</label>
          <div class="password-page__field">
            <input
              id="StorePassword"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}
                aria-invalid="true"
              {% endif %}
            >
            <button type="submit" class="button button--outline">{{ 'password.enter' | t }}</button>
          </div>
        </div>
      </details>
    {% endform %}

    <p class="password-page__footer">© {{ current_year }} {{ shop.name | escape }}</p>
  </div>
</div>

{% stylesheet %}
  .password-page {
    display: grid;
    grid-template-columns: var(--content-grid);
    min-height: 100svh;
  }

  .password-page--panel {
    background-color: var(--color-panel);
  }

  .password-page__inner {
    grid-column: 2;
    display: grid;
    gap: 1.25rem;
    align-content: center;
    justify-items: center;
    max-width: 34rem;
    margin-inline: auto;
    padding-block: 4rem 2rem;
    text-align: center;
  }

  .password-page__store {
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .password-page__title {
    font-size: clamp(2.5rem, 7vw, 4rem);
    line-height: 1.05;
  }

  .password-page__message {
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .password-page__signup {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    width: 100%;
    margin-top: 1.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .password-page__signup-title {
    font-size: 1.375rem;
  }

  .password-page__form,
  .password-page__entry-form {
    width: 100%;
  }

  .password-page__field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
  }

  .password-page__field input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .password-page__notice {
    width: 100%;
    margin-bottom: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
  }

  .password-page__entry {
    margin-top: 2rem;
  }

  .password-page__entry-toggle {
    display: inline-block;
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    list-style: none;
    cursor: pointer;
  }

  .password-page__entry-toggle::-webkit-details-marker {
    display: none;
  }

  .password-page__entry-body {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
    text-align: start;
  }

  .password-page__entry-label {
    font-size: 0.875rem;
  }

  .password-page__footer {
    margin-top: 2.5rem;
    font-size: 0.8125rem;
    opacity: 0.75;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Opening soon"
    },
    {
      "type": "paragraph",
      "content": "t:info.password_message"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "password-page--panel", "label": "t:options.background.panel" },
        { "value": "password-page--page", "label": "t:options.background.page" }
      ],
      "default": "password-page--panel"
    },
    {
      "type": "checkbox",
      "id": "show_store_name",
      "label": "t:labels.show_store_name",
      "default": true
    },
    {
      "type": "header",
      "content": "t:labels.signup"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:labels.show_signup",
      "info": "t:info.newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "t:labels.heading",
      "default": "Be the first to know when we open."
    },
    {
      "type": "text",
      "id": "signup_text",
      "label": "t:labels.text",
      "default": "Leave your email and we'll let you know when the doors open."
    }
  ]
}
{% endschema %}
