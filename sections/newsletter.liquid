{% comment %}
  Newsletter band: a heading, short text and an email sign up on the panel
  colour. Not on the home page by default, since the footer already has a
  sign up box; it can be added from the theme editor.
{% endcomment %}

{% assign form_id = 'Newsletter-' | append: section.id %}

<div class="newsletter full-width">
  <div class="newsletter__inner home-section">
    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="newsletter__text">{{ section.settings.text }}</div>
    {% endif %}

    {% form 'customer', id: form_id, class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <p class="newsletter__message" role="status">{{ 'footer.newsletter_success' | t }}</p>
      {% else %}
        <div class="newsletter__field">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ 'footer.newsletter_email' | t }}</label>
          <input
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'footer.newsletter_email' | t }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="{{ form_id }}-error"
            {% endif %}
          >
          <button type="submit" class="button">{{ 'footer.newsletter_subscribe' | t }}</button>
        </div>

        {% if form.errors %}
          <div id="{{ form_id }}-error" class="newsletter__message" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter {
    display: grid;
    grid-template-columns: var(--content-grid);
    background-color: var(--color-panel);
  }

  .newsletter__inner {
    grid-column: 2;
    display: grid;
    gap: 1rem;
    justify-items: center;
    text-align: center;
  }

  .newsletter__text {
    max-width: 36rem;
    line-height: 1.6;
  }

  .newsletter__form {
    width: 100%;
    max-width: 30rem;
    margin-top: 0.5rem;
  }

  .newsletter__field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .newsletter__field input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0 1rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .newsletter__field .button {
    flex: 1 0 auto;
  }

  .newsletter__message {
    margin-top: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Letters from the studio"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>A short note when new pieces land, plus the occasional story from the journal.</p>"
    },
    {
      "type": "paragraph",
      "content": "t:info.newsletter"
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
