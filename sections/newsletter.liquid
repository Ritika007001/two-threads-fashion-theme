{% comment %}
  Newsletter band: an eyebrow, a heading, short text and an email sign up,
  on the alternate colour by default. Not on the home page by default, since
  the footer already has a sign up box; it can be added from the theme editor.
{% endcomment %}

{% assign form_id = 'Newsletter-' | append: section.id %}

<div
  class="newsletter section-band full-width {{ section.settings.background }}"
  style="--section-scale: {{ section.settings.spacing }};"
>
  <div class="newsletter__inner section-padding" data-reveal>
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="newsletter__text">{{ section.settings.text }}</div>
    {% endif %}

    {% form 'customer', id: form_id, class: 'newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {% if form.posted_successfully? %}
        <p class="newsletter__message" role="status">{{ 'footer.newsletter_success' | t }}</p>
      {% else %}
        <div class="newsletter__field">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ 'footer.newsletter_email' | t }}</label>
          <input
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="{{ 'footer.newsletter_email' | t }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="{{ form_id }}-error"
            {% endif %}
          >
          <button type="submit" class="button">{{ 'footer.newsletter_subscribe' | t }}</button>
        </div>

        {% if form.errors %}
          <div id="{{ form_id }}-error" class="newsletter__message" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
</div>

{% stylesheet %}
  .newsletter__inner {
    display: grid;
    gap: var(--space-4);
    justify-items: center;
    text-align: center;
  }

  .newsletter__text {
    max-width: 36rem;
  }

  .newsletter__form {
    width: 100%;
    max-width: 30rem;
    margin-top: var(--space-2);
  }

  .newsletter__field {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .newsletter__field input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-foreground);
  }

  .newsletter__field .button {
    flex: 1 0 auto;
  }

  .newsletter__message {
    margin-top: var(--space-3);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "info": "t:info.eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Letters from the studio"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:labels.text",
      "default": "<p>A short note when new pieces land, plus the occasional story from the journal.</p>"
    },
    {
      "type": "paragraph",
      "content": "t:info.newsletter"
    },
    {
      "type": "header",
      "content": "t:general.layout"
    },
    {
      "type": "select",
      "id": "background",
      "label": "t:labels.background",
      "options": [
        { "value": "surface--page", "label": "t:options.background.page" },
        { "value": "surface--alternate", "label": "t:options.background.alternate" }
      ],
      "default": "surface--alternate"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "t:labels.section_spacing",
      "options": [
        { "value": "0.6", "label": "t:options.spacing.small" },
        { "value": "1", "label": "t:options.spacing.default" },
        { "value": "1.4", "label": "t:options.spacing.large" }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "t:general.newsletter"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
